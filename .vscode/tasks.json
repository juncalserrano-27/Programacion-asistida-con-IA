{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ruff check (manual)",
      "type": "shell",
      "command": "ruff check linters/ruff_manual/failing_code.py --output-format concise",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
